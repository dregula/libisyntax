+/**
+ * iSyntax transcoder patch (not in upstream OpenJPEG).
+ * Switch a J2K (raw codestream) compressor to "coefficient input" mode: the data passed to
+ * opj_write_tile() are int32 (4 bytes per sample, all components) wavelet coefficients, in the
+ * layout opj_dwt_encode() would have produced (Mallat: LL top-left, per resolution HL right,
+ * LH below, HH diagonal; row stride = tile width), already DC-level-shifted and, if the
+ * codestream signals MCT, already colour-transformed. DC shift, MCT and DWT are skipped.
+ * Call after opj_setup_encoder() and before opj_start_compress(). Reversible (5/3) only.
+ */
+OPJ_API OPJ_BOOL OPJ_CALLCONV opj_set_coefficient_input(opj_codec_t *p_codec,
+        OPJ_BOOL enable);

--- a/src/lib/openjp2/openjpeg.c
+++ b/src/lib/openjp2/openjpeg.c
@@ -407,6 +407,22 @@ void OPJ_CALLCONV opj_set_default_decoder_parameters(opj_dparameters_t
 }
 
 
+OPJ_BOOL OPJ_CALLCONV opj_set_coefficient_input(opj_codec_t *p_codec,
+        OPJ_BOOL enable)
+{
+    if (p_codec) {
+        opj_codec_private_t * l_codec = (opj_codec_private_t *) p_codec;
+        if (!l_codec->is_decompressor) {
+            /* only valid for a codec made with opj_create_compress(OPJ_CODEC_J2K):
+               m_codec is then an opj_j2k_t (for OPJ_CODEC_JP2 it would be an opj_jp2_t) */
+            opj_j2k_t * l_j2k = (opj_j2k_t *) l_codec->m_codec;
+            l_j2k->m_cp.m_coeff_input = enable;
+            return OPJ_TRUE;
+        }
+    }
+    return OPJ_FALSE;
+}
